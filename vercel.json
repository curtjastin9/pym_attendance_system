{
  "regions": ["sin1"],
  "builds": [
    { "src": "home.php", "use": "vercel-php@0.7.3", "config": { "includeFiles": ["*.php"] } },
    { "src": "index.php", "use": "vercel-php@0.7.3", "config": { "includeFiles": ["*.php"] } },
    { "src": "login.php", "use": "vercel-php@0.7.3", "config": { "includeFiles": ["*.php"] } },
    { "src": "api.php", "use": "vercel-php@0.7.3", "config": { "includeFiles": ["*.php"] } },
    { "src": "api_records.php", "use": "vercel-php@0.7.3", "config": { "includeFiles": ["*.php"] } },
    { "src": "api_coy.php", "use": "vercel-php@0.7.3", "config": { "includeFiles": ["*.php"] } },
    { "src": "api_attendance.php", "use": "vercel-php@0.7.3", "config": { "includeFiles": ["*.php"] } },
    { "src": "api_account.php", "use": "vercel-php@0.7.3", "config": { "includeFiles": ["*.php"] } },
    { "src": "api_slotchange.php", "use": "vercel-php@0.7.3", "config": { "includeFiles": ["*.php"] } },
    { "src": "api_eventleaders.php", "use": "vercel-php@0.7.3", "config": { "includeFiles": ["*.php"] } },
    { "src": "api_bulkdelete.php", "use": "vercel-php@0.7.3", "config": { "includeFiles": ["*.php"] } },
    { "src": "api_bulkyouth.php", "use": "vercel-php@0.7.3", "config": { "includeFiles": ["*.php"] } },
    { "src": "**/*.png", "use": "@vercel/static" },
    { "src": "**/*.jpg", "use": "@vercel/static" },
    { "src": "**/*.jpeg", "use": "@vercel/static" },
    { "src": "**/*.ico", "use": "@vercel/static" },
    { "src": "**/*.svg", "use": "@vercel/static" },
    { "src": "**/*.webp", "use": "@vercel/static" },
    { "src": "**/*.PNG", "use": "@vercel/static" },
    { "src": "**/*.JPG", "use": "@vercel/static" },
    { "src": "**/*.css", "use": "@vercel/static" },
    { "src": "**/*.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/home.php" },
    { "src": "/(index|login)\\.html", "dest": "/home.php" },
    { "src": "/(home|index|login|api|api_records|api_coy|api_attendance|api_account|api_slotchange|api_eventleaders|api_bulkdelete|api_bulkyouth)\\.php", "dest": "/$1.php" },
    { "src": "/(session|config|security|attendance_schema|mail|eventleaders_lib)\\.php", "status": 404, "dest": "/home.php" },
    { "handle": "filesystem" },
    { "src": "/logo\\.png", "dest": "/LOGO.png" }
  ]
}
