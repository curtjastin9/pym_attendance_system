{
  "builds": [
    { "src": "home.php", "use": "vercel-php@0.7.3", "config": { "includeFiles": ["*.php"] } },
    { "src": "index.php", "use": "vercel-php@0.7.3", "config": { "includeFiles": ["*.php"] } },
    { "src": "login.php", "use": "vercel-php@0.7.3", "config": { "includeFiles": ["*.php"] } },
    { "src": "public.php", "use": "vercel-php@0.7.3", "config": { "includeFiles": ["*.php"] } },
    { "src": "api.php", "use": "vercel-php@0.7.3", "config": { "includeFiles": ["*.php"] } },
    { "src": "api_public.php", "use": "vercel-php@0.7.3", "config": { "includeFiles": ["*.php"] } },
    { "src": "api_records.php", "use": "vercel-php@0.7.3", "config": { "includeFiles": ["*.php"] } },
    { "src": "api_coy.php", "use": "vercel-php@0.7.3", "config": { "includeFiles": ["*.php"] } },
    { "src": "api_attendance.php", "use": "vercel-php@0.7.3", "config": { "includeFiles": ["*.php"] } },
    { "src": "*.{css,js,png,ico,jpg,svg}", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/home.php" },
    { "src": "/(index|login)\\.html", "dest": "/home.php" },
    { "src": "/(home|index|login|public|api|api_public|api_records|api_coy|api_attendance)\\.php", "dest": "/$1.php" },
    { "src": "/(session|config|security|attendance_schema)\\.php", "status": 404, "dest": "/home.php" },
    { "handle": "filesystem" }
  ]
}
